# SASTify Environment Configuration
# Copy this file to .env and fill in your values

# Required: DeepSeek API key for AI vulnerability analysis
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Database path (default: ./sastify_data/sastify.db)
DATABASE_PATH=./sastify_data/sastify.db

# Optional: Log level (default: INFO)
LOG_LEVEL=INFO
