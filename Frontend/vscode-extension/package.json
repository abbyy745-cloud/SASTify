{
  "name": "sastify-security",
  "displayName": "SASTify - AI Security Scanner",
  "description": "AI-powered static application security testing for JavaScript and Python",
  "version": "1.0.0",
  "publisher": "SASTify",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SASTify/sastify-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:python",
    "onCommand:sastify.scanFile",
    "onCommand:sastify.scanSelection",
    "onCommand:sastify.scanWorkspace",
    "onCommand:sastify.enterToken",
    "onCommand:sastify.clearToken"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sastify.scanFile",
        "title": "SASTify: Scan Current File",
        "category": "SASTify"
      },
      {
        "command": "sastify.scanSelection",
        "title": "SASTify: Scan Selected Code",
        "category": "SASTify"
      },
      {
        "command": "sastify.scanWorkspace",
        "title": "SASTify: Scan Workspace",
        "category": "SASTify"
      },
      {
        "command": "sastify.showResults",
        "title": "SASTify: Show Scan Results",
        "category": "SASTify"
      },
      {
        "command": "sastify.enterToken",
        "title": "SASTify: Enter / Update API Token",
        "category": "SASTify"
      },
      {
        "command": "sastify.clearToken",
        "title": "SASTify: Clear Saved Token",
        "category": "SASTify"
      }
    ],
    "menus": {
      "command-palette": [
        {
          "command": "sastify.scanFile",
          "when": "editorLangId == javascript || editorLangId == python"
        },
        {
          "command": "sastify.scanSelection",
          "when": "editorHasSelection && (editorLangId == javascript || editorLangId == python)"
        },
        {
          "command": "sastify.scanWorkspace",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/context": [
        {
          "command": "sastify.scanSelection",
          "when": "editorHasSelection && (editorLangId == javascript || editorLangId == python)",
          "group": "security"
        }
      ]
    },
    "configuration": {
      "title": "SASTify",
      "properties": {
        "sastify.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "SASTify backend API URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.116.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.15.2"
  }
}
